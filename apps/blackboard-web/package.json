{
  "name": "@gjuoun/blackboard",
  "version": "0.3.0-beta.0",
  "description": "Local web app for reading planning docs and commenting on the text, with a CLI so coding agents can join the review",
  "keywords": [
    "markdown",
    "review",
    "comments",
    "mermaid",
    "cli",
    "coding-agent",
    "planning"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gjuoun/blackboard#readme",
  "bugs": {
    "url": "https://github.com/gjuoun/blackboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjuoun/blackboard.git",
    "directory": "apps/blackboard-web"
  },
  "author": "Jun Guo",
  "bin": {
    "blackboard": "bin/blackboard"
  },
  "files": [
    "bin/blackboard",
    "dist",
    "server",
    "!server/**/*.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cli": "bun scripts/build-cli.ts",
    "prepack": "bun run build:cli && bun run build && bun run build:server",
    "start": "bin/blackboard serve start --foreground",
    "lint": "biome check .",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "bun test",
    "test:update": "UPDATE_SNAPSHOTS=1 bun test test/cli-snapshot.test.ts test/wire-snapshot.test.ts",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test",
    "build:server": "bun scripts/build-server.ts",
    "db:generate": "bunx drizzle-kit generate && bun scripts/gen-migrations.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "@gjuoun/bb-ui": "workspace:*",
    "@gjuoun/safe-ts": "^0.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/router-cli": "^1.168.0",
    "@types/bun": "^1.4.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "effect": "4.1.2",
    "hono": "^4.13.17",
    "katex": "^0.16.47",
    "lucide-react": "^1.61.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.2.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.14",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
