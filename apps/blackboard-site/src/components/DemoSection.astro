---
import DemoApp from "./demo/DemoApp";
import { PhoneFrame } from "./demo/PhoneFrame";
import type { Dict } from "../i18n/types.ts";

interface Props {
  demo: Dict["demo"];
}

const { demo } = Astro.props;
---

<section class="wrap demo-sec">
  <h2 class="sec">{demo.heading}</h2>
  <PhoneFrame>
    <DemoApp client:visible dict={demo} />
  </PhoneFrame>
  <p class="cap">{demo.caption}</p>
</section>