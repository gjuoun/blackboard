{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!apps/blackboard-web/lib/db/migrations/bundled.ts",
      "!**/*.tsbuildinfo",
      "!**/*.gen.ts",
      "!apps/blackboard-web/test/*.json",
      "!packages/bb-ui/src/components/ui",
      "!apps/blackboard-web/docs",
      "!apps/blackboard-web/dist",
      "!apps/blackboard-web/server",
      "!apps/blackboard-web/sketches",
      "!**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSameLine": false
    }
  },
  "json": { "formatter": { "enabled": true, "indentWidth": 2 } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next": "No Next.js in this repo: the app is TanStack Start.",
              "next/*": "No Next.js in this repo: the app is TanStack Start."
            }
          }
        }
      },
      "suspicious": {
        "useIterableCallbackReturn": "warn",
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn"
      },
      "security": { "noDangerouslySetInnerHtml": "warn" },
      "a11y": {
        "useKeyWithClickEvents": "warn",
        "noStaticElementInteractions": "warn",
        "useSemanticElements": "warn",
        "useButtonType": "warn",
        "noRedundantAlt": "warn",
        "noSvgWithoutTitle": "warn",
        "noAutofocus": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/test/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "correctness": { "noComponentHookFactories": "off", "noEmptyCharacterClassInRegex": "off" },
          "a11y": { "useKeyWithClickEvents": "off", "noStaticElementInteractions": "off" }
        }
      }
    },
    { "includes": ["apps/blackboard-site/src/**"], "formatter": { "enabled": false } }
  ]
}
