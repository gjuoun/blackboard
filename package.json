{
  "name": "blackboard-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/blackboard-web dev",
    "build": "bun run --cwd apps/blackboard-web build",
    "build:server": "bun run --cwd apps/blackboard-web build:server",
    "build:cli": "bun run --cwd apps/blackboard-web build:cli",
    "typecheck": "bun run --cwd apps/blackboard-web typecheck && bun run --cwd packages/bb-ui typecheck",
    "lint": "bun run --cwd apps/blackboard-web lint",
    "test": "bun test",
    "db:generate": "bun run --cwd apps/blackboard-web db:generate"
  }
}