{
  "name": "@gjuoun/blackboard",
  "version": "0.3.0-beta.0",
  "description": "Local web app for reading planning docs and commenting on the text, with a CLI so coding agents can join the review",
  "keywords": [
    "markdown",
    "review",
    "comments",
    "mermaid",
    "cli",
    "coding-agent",
    "planning"
  ],
  "license": "MIT",
  "homepage": "https://github.com/gjuoun/blackboard#readme",
  "bugs": {
    "url": "https://github.com/gjuoun/blackboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjuoun/blackboard.git"
  },
  "author": "Jun Guo",
  "bin": {
    "blackboard": "bin/blackboard"
  },
  "files": [
    "bin/blackboard",
    "dist",
    "server",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p ${PORT:-38770}",
    "build": "next build",
    "build:cli": "bun scripts/build-cli.ts",
    "start": "bin/blackboard serve start --foreground",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build && bun run build:server && bun run build:cli",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test",
    "build:server": "bun scripts/build-server.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/unist": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.61.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.2.0",
    "next": "16.4.2",
    "postcss": "^8.5.31",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-parse": "^9.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
